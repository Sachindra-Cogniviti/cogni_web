{
  "name": "cogni_web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "check:links": "node scripts/check-internal-links.mjs",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate:create": "payload migrate:create",
    "migrate": "payload migrate",
    "seed:demo": "node --env-file=.env --import=tsx scripts/seed-demo.ts",
    "seed:demo:remove": "node --env-file=.env --import=tsx scripts/seed-demo.ts --remove"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@payloadcms/db-postgres": "^3.88.0",
    "@payloadcms/email-resend": "^3.88.0",
    "@payloadcms/live-preview-react": "^3.88.0",
    "@payloadcms/next": "^3.88.0",
    "@payloadcms/plugin-seo": "^3.88.0",
    "@payloadcms/richtext-lexical": "^3.88.0",
    "@payloadcms/storage-s3": "^3.88.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "dotted-map": "^3.1.0",
    "graphql": "^16.14.2",
    "motion": "^13.2.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "payload": "^3.88.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.4",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0"
  },
  "//overrides": [
    "Next bundles its own sharp (0.34.5) for image optimisation while Payload",
    "uses the one declared above. Two sharp versions means two @img platform",
    "packages, and on Windows both ship a libvips-42.dll under that exact same",
    "filename built against different libvips (8.17.3 vs 8.18.6). Windows",
    "resolves a DLL by name once per process, so whichever sharp initialises",
    "first pins libvips-42.dll for the whole process and the other one's native",
    "addon then fails to find its symbols - ERR_DLOPEN_FAILED, 'the specified",
    "procedure could not be found', on the first request to /admin.",
    "",
    "$sharp pins the whole tree to the version declared in dependencies, so",
    "there is one sharp, one @img package and one libvips. Do not remove this",
    "to 'clean up duplicate deps' - the duplication is the bug."
  ],
  "overrides": {
    "sharp": "$sharp"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
