# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# /out/ was committed while cPanel deployed the repo verbatim. Vercel builds
# from source, and without output: "export" nothing writes here any more.
/out/

# vercel
.vercel

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# typescript
*.tsbuildinfo
next-env.d.ts

DEPLOYMENT_PLAN.md

# Terraform - NEVER commit these, they contain secrets and local state
terraform/*.tfvars
!terraform/*.tfvars.example
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/terraform.tfstate
terraform/terraform.tfstate.backup
terraform/*.tfstate*
terraform/waf-iam-policy.json
container_definitions.json
